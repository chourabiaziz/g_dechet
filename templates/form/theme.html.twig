{% use 'bootstrap_5_layout.html.twig' %}

{% block form_row %}
    {% set row_attr = row_attr|merge({class: (row_attr.class|default('') ~ ' mb-3')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block form_label %}
    {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' form-label fw-bold')|trim}) %}
    {{ parent() }}
{% endblock %}

{% block form_errors %}
    {% if errors|length > 0 %}
        <div class="alert alert-danger mt-2">
            <ul class="mb-0">
                {% for error in errors %}
                    <li>{{ error.message }}</li>
                {% endfor %}
            </ul>
        </div>
    {% endif %}
{% endblock %}

{% block submit_row %}
    <div class="mb-3">
        {{ form_widget(form) }}
    </div>
{% endblock %}