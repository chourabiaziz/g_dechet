{% extends 'base.html.twig' %}

{% block title %}Déclaration de Déchet{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
{% endblock %}

{% block body %}
<div class=" ">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="ti ti-file-text me-3 fs-2"></i>
                        <div>
                            <h2 class="h4 mb-0">Étape 1: Déclaration du Déchet</h2>
                            <p class="mb-0 opacity-75">Enregistrez un nouveau déchet dans le système</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                {{ form_widget(form.type, {'attr': {'class': 'form-select', 'placeholder': ' '}}) }}
                                {{ form_label(form.type) }}
                                <div class="form-text">
                                    <i class="ti ti-info-circle me-1"></i>
                                    Sélectionnez le type de déchet
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                {{ form_widget(form.quantite, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                {{ form_label(form.quantite) }}
                                <div class="form-text">
                                    <i class="ti ti-scale me-1"></i>
                                    Quantité en kilogrammes
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                {{ form_widget(form.source, {'attr': {'class': 'form-select', 'placeholder': ' '}}) }}
                                {{ form_label(form.source) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                {{ form_widget(form.acteur, {'attr': {'class': 'form-select', 'placeholder': ' '}}) }}
                                {{ form_label(form.acteur) }}
                            </div>
                        </div>
                    </div>
                    
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                {{ form_widget(form.infrastructure, {'attr': {'class': 'form-select', 'placeholder': ' '}}) }}
                                {{ form_label(form.infrastructure) }}
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="form-floating">
                                {{ form_widget(form.etat, {'attr': {'class': 'form-select', 'placeholder': ' '}}) }}
                                {{ form_label(form.etat) }}
                            </div>
                        </div>
                    </div>

                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <div class="form-floating">
                                {{ form_widget(form.dateProduction, {'attr': {'class': 'form-control', 'placeholder': ' '}}) }}
                                {{ form_label(form.dateProduction) }}
                                <div class="form-text">
                                    <i class="ti ti-calendar me-1"></i>
                                    Date de production du déchet
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="alert alert-info border-0">
                        <div class="d-flex">
                            <i class="ti ti-info-circle me-3 fs-5 text-info"></i>
                            <div>
                                <h6 class="alert-heading mb-2">Information importante</h6>
                                <p class="mb-0">Tous les champs marqués d'un astérisque (*) sont obligatoires. La déclaration initiale permet de lancer le processus de gestion du déchet.</p>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3 mt-4 pt-3 border-top">
                        <button type="submit" class="btn btn-success btn-lg px-4">
                            <i class="ti ti-check me-2"></i>
                            Déclarer le Déchet
                        </button>
                        <a href="{{ path('app_dechet_workflow') }}" class="btn btn-outline-secondary btn-lg px-4">
                            <i class="ti ti-arrow-left me-2"></i>
                            Retour au Workflow
                        </a>
                    </div>
                    
                    {{ form_end(form) }}
                </div>
            </div>
        </div>
    </div>
</div>

<style>
.card {
    border-radius: 15px;
}
.form-floating > .form-control:focus ~ label,
.form-floating > .form-control:not(:placeholder-shown) ~ label {
    color: #0d6efd;
    font-weight: 500;
}
.btn-success {
    background: linear-gradient(135deg, #198754 0%, #157347 100%);
    border: none;
    border-radius: 10px;
}
.btn-success:hover {
    background: linear-gradient(135deg, #157347 0%, #0f5132 100%);
    transform: translateY(-1px);
}
</style>
{% endblock %}