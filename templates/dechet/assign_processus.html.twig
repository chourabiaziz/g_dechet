{% extends 'base.html.twig' %}

{% block title %}Assignation au Processus{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
{% endblock %}

{% block body %}
<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-xl-8 col-lg-10">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white py-3">
                    <div class="d-flex align-items-center">
                        <i class="ti ti-settings me-3 fs-2"></i>
                        <div>
                            <h2 class="h4 mb-0">Étape 2: Assignation au Processus</h2>
                            <p class="mb-0 opacity-75">Sélectionnez le processus de traitement</p>
                        </div>
                    </div>
                </div>
                <div class="card-body p-4">
                    
                    <!-- Informations du déchet -->
                    <div class="dechet-info mb-4 p-4 bg-light rounded-3 border-start border-4 border-primary">
                        <div class="d-flex align-items-center mb-3">
                            <i class="ti ti-info-circle me-2 text-primary fs-5"></i>
                            <h5 class="mb-0 fw-bold">Déchet à traiter</h5>
                        </div>
                        <div class="row g-3">
                            <div class="col-sm-6 col-md-3">
                                <div class="d-flex align-items-center">
                                    <i class="ti ti-id me-2 text-muted"></i>
                                    <div>
                                        <small class="text-muted">ID</small>
                                        <div class="fw-bold">#{{ dechet.id }}</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="d-flex align-items-center">
                                    <i class="ti ti-tag me-2 text-muted"></i>
                                    <div>
                                        <small class="text-muted">Type</small>
                                        <div class="fw-bold">{{ dechet.type }}</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="d-flex align-items-center">
                                    <i class="ti ti-scale me-2 text-muted"></i>
                                    <div>
                                        <small class="text-muted">Quantité</small>
                                        <div class="fw-bold">{{ dechet.quantite }} kg</div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-sm-6 col-md-3">
                                <div class="d-flex align-items-center">
                                    <i class="ti ti-circle-dot me-2 text-muted"></i>
                                    <div>
                                        <small class="text-muted">État</small>
                                        <div>
                                            <span class="badge bg-warning fs-6">{{ dechet.etat }}</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        {% if dechet.source or dechet.acteur %}
                        <div class="row g-3 mt-2">
                            {% if dechet.source %}
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center">
                                    <i class="ti ti-source me-2 text-muted"></i>
                                    <div>
                                        <small class="text-muted">Source</small>
                                        <div class="fw-bold">{{ dechet.source.nom }}</div>
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                            {% if dechet.acteur %}
                            <div class="col-sm-6">
                                <div class="d-flex align-items-center">
                                    <i class="ti ti-user me-2 text-muted"></i>
                                    <div>
                                        <small class="text-muted">Acteur</small>
                                        <div class="fw-bold">{{ dechet.acteur.nom }}</div>
                                    </div>
                                </div>
                            </div>
                            {% endif %}
                        </div>
                        {% endif %}
                    </div>

                    <!-- Formulaire d'assignation -->
                    {% if processus_disponibles|length > 0 %}
                        <form method="post" class="needs-validation" novalidate>
                            <div class="mb-4">
                                <label for="processus_id" class="form-label fw-bold fs-6 mb-3">
                                    <i class="ti ti-list-check me-2 text-primary"></i>
                                    Sélectionner un processus
                                </label>
                                <select name="processus_id" id="processus_id" class="form-select form-select-lg" required>
                                    <option value="">Choisir un processus...</option>
                                    {% for processus in processus_disponibles %}
                                        <option value="{{ processus.id }}" data-autorite="{{ processus.autorite ? processus.autorite.nom : 'Aucune' }}" data-type="{{ processus.type }}">
                                            {{ processus.nom }} 
                                            <small class="text-muted">({{ processus.type }})</small>
                                        </option>
                                    {% endfor %}
                                </select>
                                <div class="form-text mt-2">
                                    <i class="ti ti-help me-1"></i>
                                    Sélectionnez le processus de traitement approprié pour ce déchet
                                </div>
                                <div id="processus-details" class="mt-3 p-3 bg-light rounded d-none">
                                    <div class="row">
                                        <div class="col-sm-6">
                                            <small class="text-muted">Autorité responsable:</small>
                                            <div id="autorite-info" class="fw-bold"></div>
                                        </div>
                                        <div class="col-sm-6">
                                            <small class="text-muted">Type de processus:</small>
                                            <div id="type-info" class="fw-bold"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="alert alert-info border-0 bg-light">
                                <div class="d-flex">
                                    <i class="ti ti-info-circle me-3 fs-5 text-info"></i>
                                    <div>
                                        <h6 class="alert-heading mb-2">Information</h6>
                                        <p class="mb-0">
                                            En assignant un processus, le déchet passera à l'état "en processus" 
                                            et pourra ensuite être transformé en produit recyclé.
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex gap-3 mt-4 pt-3 border-top">
                                <button type="submit" class="btn btn-success btn-lg px-4">
                                    <i class="ti ti-check me-2"></i>
                                    Assigner le Processus
                                </button>
                                <a href="{{ path('app_dechet_processus_list') }}" class="btn btn-outline-secondary btn-lg px-4">
                                    <i class="ti ti-arrow-left me-2"></i>
                                    Retour à la liste
                                </a>
                                <a href="{{ path('app_dechet_workflow') }}" class="btn btn-outline-primary btn-lg px-4">
                                    <i class="ti ti-road me-2"></i>
                                    Workflow
                                </a>
                            </div>
                        </form>
                    {% else %}
                        <div class="alert alert-warning text-center border-0 py-4">
                            <i class="ti ti-alert-triangle fs-1 text-warning mb-3 d-block"></i>
                            <h5 class="fw-bold">Aucun processus disponible</h5>
                            <p class="mb-3">Il n'y a actuellement aucun processus configuré dans le système.</p>
                            <div class="d-flex gap-2 justify-content-center">
                                <a href="{{ path('app_processus_new') }}" class="btn btn-primary btn-lg px-4">
                                    <i class="ti ti-plus me-2"></i>
                                    Créer un processus
                                </a>
                                <a href="{{ path('app_dechet_processus_list') }}" class="btn btn-outline-secondary btn-lg px-4">
                                    <i class="ti ti-arrow-left me-2"></i>
                                    Retour
                                </a>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    const select = document.getElementById('processus_id');
    const detailsDiv = document.getElementById('processus-details');
    const autoriteInfo = document.getElementById('autorite-info');
    const typeInfo = document.getElementById('type-info');
    
    // Afficher les détails du processus sélectionné
    select.addEventListener('change', function() {
        const selectedOption = this.options[this.selectedIndex];
        if (selectedOption.value) {
            const autorite = selectedOption.getAttribute('data-autorite');
            const type = selectedOption.getAttribute('data-type');
            
            autoriteInfo.textContent = autorite;
            typeInfo.textContent = type;
            detailsDiv.classList.remove('d-none');
        } else {
            detailsDiv.classList.add('d-none');
        }
        
        // Retirer l'erreur de validation
        this.classList.remove('is-invalid');
        const errorDiv = this.parentNode.querySelector('.invalid-feedback');
        if (errorDiv) {
            errorDiv.remove();
        }
    });
    
    // Validation du formulaire
    const form = document.querySelector('form');
    if (form) {
        form.addEventListener('submit', function(e) {
            if (!select.value) {
                e.preventDefault();
                select.classList.add('is-invalid');
                const errorDiv = document.createElement('div');
                errorDiv.className = 'invalid-feedback';
                errorDiv.innerHTML = '<i class="ti ti-alert-circle me-1"></i>Veuillez sélectionner un processus.';
                select.parentNode.appendChild(errorDiv);
                
                // Scroll to error
                select.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });
    }
    
    // Focus sur le select
    if (select) {
        select.focus();
    }
});
</script>

<style>
.card {
    border-radius: 15px;
}
.dechet-info {
    background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
}
.btn-success {
    background: linear-gradient(135deg, #198754 0%, #157347 100%);
    border: none;
    border-radius: 10px;
    transition: all 0.3s ease;
}
.btn-success:hover {
    background: linear-gradient(135deg, #157347 0%, #0f5132 100%);
    transform: translateY(-1px);
    box-shadow: 0 4px 15px rgba(25, 135, 84, 0.3);
}
.form-select:focus {
    border-color: #0d6efd;
    box-shadow: 0 0 0 0.2rem rgba(13, 110, 253, 0.25);
}
</style>
{% endblock %}