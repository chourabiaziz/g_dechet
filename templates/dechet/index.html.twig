{% extends 'base.html.twig' %}

{% block title %}Dechet index{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="mb-0">Dechets</h1>
        <input type="search" class="form-control form-control-sm js-table-search" style="max-width: 280px;" data-target="#dechets-table" placeholder="Recherche dynamique...">
    </div>

    <table id="dechets-table" class="table table-striped" data-sortable="true">
        <thead>
            <tr>
                <th>Id</th>
                <th>Type</th>
                <th>Quantite</th>
                <th>DateProduction</th>
                <th>Etat</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for dechet in dechets %}
            <tr>
                <td>{{ dechet.id }}</td>
                <td>{{ dechet.type }}</td>
                <td>{{ dechet.quantite }}</td>
                <td>{{ dechet.dateProduction ? dechet.dateProduction|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ dechet.etat }}</td>
                <td>
                    <a href="{{ path('app_dechet_show', {'id': dechet.id}) }}"class="btn btn-info"><i class="ti ti-eye"></i></a>
                    <a href="{{ path('app_dechet_edit', {'id': dechet.id}) }}"class="btn btn-secondary"><i class="ti ti-settings"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_dechet_new') }}"class="btn btn-success">Create new</a>
{% endblock %}
