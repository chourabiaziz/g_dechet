{% extends 'base.html.twig' %}

{% block title %}Traçabilité du Déchet #{{ dechet.id }}{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-10 offset-md-1">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <h2>📊 Traçabilité du Déchet</h2>
                        <span class="badge bg-light text-dark">ID: {{ dechet.id }}</span>
                    </div>
                </div>
                <div class="card-body">
                    
                    <!-- Informations du déchet -->
                    <div class="row mb-4">
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5>📋 Informations du Déchet</h5>
                                </div>
                                <div class="card-body">
                                    <table class="table table-sm">
                                        <tr>
                                            <th>Type:</th>
                                            <td>{{ dechet.type }}</td>
                                        </tr>
                                        <tr>
                                            <th>Quantité:</th>
                                            <td>{{ dechet.quantite }} kg</td>
                                        </tr>
                                        <tr>
                                            <th>État:</th>
                                            <td>
                                                <span class="badge 
                                                    {% if dechet.etat == 'declare' %}bg-warning
                                                    {% elseif dechet.etat == 'en_processus' %}bg-info
                                                    {% elseif dechet.etat == 'transforme' %}bg-success
                                                    {% else %}bg-secondary{% endif %}">
                                                    {{ dechet.etat }}
                                                </span>
                                            </td>
                                        </tr>
                                        <tr>
                                            <th>Date Production:</th>
                                            <td>{{ dechet.dateProduction|date('d/m/Y H:i') }}</td>
                                        </tr>
                                        {% if dechet.source %}
                                        <tr>
                                            <th>Source:</th>
                                            <td>{{ dechet.source.nom }}</td>
                                        </tr>
                                        {% endif %}
                                        {% if dechet.acteur %}
                                        <tr>
                                            <th>Acteur:</th>
                                            <td>{{ dechet.acteur.nom }}</td>
                                        </tr>
                                        {% endif %}
                                    </table>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6">
                            <div class="card">
                                <div class="card-header">
                                    <h5>🔄 Processus Associés</h5>
                                </div>
                                <div class="card-body">
                                    {% if dechet.processuses|length > 0 %}
                                        <ul class="list-group">
                                            {% for processus in dechet.processuses %}
                                                <li class="list-group-item">
                                                    <strong>{{ processus.nom }}</strong>
                                                    <br>
                                                    <small class="text-muted">Type: {{ processus.type }}</small>
                                                    {% if processus.autorite %}
                                                        <br><small>Autorité: {{ processus.autorite.nom }}</small>
                                                    {% endif %}
                                                </li>
                                            {% endfor %}
                                        </ul>
                                    {% else %}
                                        <p class="text-muted">Aucun processus assigné</p>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Produit recyclé -->
                    {% if dechet.produitrecycle %}
                    <div class="row mb-4">
                        <div class="col-12">
                            <div class="card border-success">
                                <div class="card-header bg-success text-white">
                                    <h5>✅ Produit Recyclé Créé</h5>
                                </div>
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <strong>Nom:</strong> {{ dechet.produitrecycle.nom }}<br>
                                            <strong>Type:</strong> {{ dechet.produitrecycle.type }}
                                        </div>
                                        <div class="col-md-6">
                                            {% if dechet.produitrecycle.boucle %}
                                                <strong>Boucle d'économie:</strong> {{ dechet.produitrecycle.boucle.nom }}<br>
                                                <strong>Objectif:</strong> {{ dechet.produitrecycle.boucle.objectif }}
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    {% endif %}

                    <!-- Historique de traçabilité -->
                    <div class="row">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5>📈 Historique de Traçabilité</h5>
                                </div>
                                <div class="card-body">
                                    {% if dechet.tracabilite %}
                                        <div class="tracability-timeline">
                                            {% set historiqueLines = dechet.tracabilite.historique|split('\n') %}
                                            {% for line in historiqueLines %}
                                                {% if line|trim %}
                                                    <div class="timeline-item {% if loop.first %}first{% elseif loop.last %}last{% endif %}">
                                                        <div class="timeline-marker"></div>
                                                        <div class="timeline-content">
                                                            {{ line|trim }}
                                                        </div>
                                                    </div>
                                                {% endif %}
                                            {% endfor %}
                                        </div>
                                        <div class="mt-3 text-end">
                                            <small class="text-muted">
                                                Dernière mise à jour: {{ dechet.tracabilite.dateMiseAJour|date('d/m/Y H:i') }}
                                            </small>
                                        </div>
                                    {% else %}
                                        <p class="text-muted">Aucun historique de traçabilité disponible.</p>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Résumé du parcours -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="card">
                                <div class="card-header">
                                    <h5>🎯 Résumé du Parcours</h5>
                                </div>
                                <div class="card-body">
                                    <div class="progress mb-3" style="height: 30px;">
                                        {% set progress = 0 %}
                                        {% if dechet.etat == 'declare' %}{% set progress = 25 %}
                                        {% elseif dechet.etat == 'en_processus' %}{% set progress = 50 %}
                                        {% elseif dechet.etat == 'transforme' %}{% set progress = 100 %}
                                        {% endif %}
                                        
                                        <div class="progress-bar bg-success" role="progressbar" 
                                             style="width: {{ progress }}%;" 
                                             aria-valuenow="{{ progress }}" 
                                             aria-valuemin="0" 
                                             aria-valuemax="100">
                                            {{ progress }}% Complet
                                        </div>
                                    </div>
                                    
                                    <div class="row text-center">
                                        <div class="col-md-3">
                                            <div class="step-indicator {% if dechet.etat != 'non_declare' %}completed{% endif %}">
                                                <span class="step-number">1</span>
                                                <div>Déclaration</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="step-indicator {% if dechet.processuses|length > 0 %}completed{% endif %}">
                                                <span class="step-number">2</span>
                                                <div>Processus</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="step-indicator {% if dechet.produitrecycle %}completed{% endif %}">
                                                <span class="step-number">3</span>
                                                <div>Transformation</div>
                                            </div>
                                        </div>
                                        <div class="col-md-3">
                                            <div class="step-indicator active">
                                                <span class="step-number">4</span>
                                                <div>Traçabilité</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Actions -->
                    <div class="row mt-4">
                        <div class="col-12">
                            <div class="d-flex justify-content-between flex-wrap gap-2">
                                <div>
                                    <a href="{{ path('app_dechet_workflow') }}" class="btn btn-secondary">
                                        ← Retour au Workflow
                                    </a>
                                    <a href="{{ path('app_dechet_dashboard') }}" class="btn btn-info">
                                        📊 Tableau de Bord
                                    </a>
                                </div>
                                <div>
                                    {% if dechet.etat == 'declare' %}
                                        <a href="{{ path('app_dechet_processus_assign', {'id': dechet.id}) }}" class="btn btn-warning">
                                            ⚙️ Assigner un Processus
                                        </a>
                                    {% elseif dechet.etat == 'en_processus' %}
                                        <a href="{{ path('app_dechet_transformation', {'id': dechet.id}) }}" class="btn btn-success">
                                            🔄 Transformer
                                        </a>
                                    {% endif %}
                                    {% if dechet.etat == 'transforme' %}
                                        <span class="badge bg-success fs-6 p-2">
                                            ✅ Transformation terminée
                                        </span>
                                    {% endif %}
                                </div>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>

<style>
.tracability-timeline {
    position: relative;
    padding-left: 30px;
}

.timeline-item {
    position: relative;
    margin-bottom: 20px;
    padding-left: 20px;
}

.timeline-marker {
    position: absolute;
    left: -30px;
    top: 5px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #007bff;
    border: 3px solid white;
    box-shadow: 0 0 0 3px #007bff;
}

.timeline-item.first .timeline-marker {
    background: #28a745;
    box-shadow: 0 0 0 3px #28a745;
}

.timeline-item.last .timeline-marker {
    background: #6c757d;
    box-shadow: 0 0 0 3px #6c757d;
}

.timeline-content {
    background: #f8f9fa;
    padding: 10px 15px;
    border-radius: 5px;
    border-left: 3px solid #007bff;
}

.timeline-item.first .timeline-content {
    border-left-color: #28a745;
}

.timeline-item.last .timeline-content {
    border-left-color: #6c757d;
}

.step-indicator {
    text-align: center;
    padding: 10px;
}

.step-number {
    display: inline-block;
    width: 30px;
    height: 30px;
    line-height: 30px;
    border-radius: 50%;
    background: #6c757d;
    color: white;
    margin-bottom: 5px;
}

.step-indicator.completed .step-number {
    background: #28a745;
}

.step-indicator.active .step-number {
    background: #007bff;
    font-weight: bold;
}
</style>
{% endblock %}