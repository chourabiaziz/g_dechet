{% extends 'base.html.twig' %}

{% block title %}Déchets à Assigner aux Processus{% endblock %}

{% block body %}
<div class="container mt-4">
    <h1 class="mb-4">⚙️ Déchets à Assigner aux Processus</h1>

    {% if dechets|length > 0 %}
    <div class="card">
        <div class="card-header">
            <h5>{{ dechets|length }} déchet(s) en attente d'assignation</h5>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped">
                    <thead>
                        <tr>
                            <th>ID</th>
                            <th>Type</th>
                            <th>Quantité</th>
                            <th>Source</th>
                            <th>Date Production</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for dechet in dechets %}
                        <tr>
                            <td>{{ dechet.id }}</td>
                            <td>{{ dechet.type }}</td>
                            <td>{{ dechet.quantite }} kg</td>
                            <td>{{ dechet.source ? dechet.source.nom : 'N/A' }}</td>
                            <td>{{ dechet.dateProduction|date('d/m/Y H:i') }}</td>
                            <td>
                                <a href="{{ path('app_dechet_processus_assign', {'id': dechet.id}) }}" 
                                   class="btn btn-sm btn-primary">
                                    ⚙️ Assigner un processus
                                </a>
                                <a href="{{ path('app_dechet_tracabilite_view', {'id': dechet.id}) }}" 
                                   class="btn btn-sm btn-outline-info">
                                    📊 Voir
                                </a>
                            </td>
                        </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    {% else %}
    <div class="alert alert-info text-center">
        <h4>🎉 Aucun déchet en attente d'assignation !</h4>
        <p>Tous les déchets déclarés ont été assignés à des processus.</p>
        <a href="{{ path('app_dechet_declaration') }}" class="btn btn-success">
            📝 Déclarer un nouveau déchet
        </a>
    </div>
    {% endif %}

    <div class="mt-3">
        <a href="{{ path('app_dechet_workflow') }}" class="btn btn-secondary">
            ← Retour au workflow
        </a>
        <a href="{{ path('app_dechet_dashboard') }}" class="btn btn-info">
            📊 Tableau de bord
        </a>
    </div>
</div>
{% endblock %}