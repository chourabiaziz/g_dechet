{% extends 'base.html.twig' %}

{% block title %}Acteur index{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="mb-0">Acteur index</h1>
        <input type="search" class="form-control form-control-sm js-table-search" style="max-width: 280px;" data-target="#actors-table" placeholder="Recherche dynamique...">
    </div>

    <table id="actors-table" class="table table-striped" data-sortable="true">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Role</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for acteur in acteurs %}
            <tr>
                <td>{{ acteur.id }}</td>
                <td>{{ acteur.nom }}</td>
                <td>{{ acteur.role }}</td>
                <td>
                    <a href="{{ path('app_acteur_show', {'id': acteur.id}) }}"class="btn btn-info"><i class="ti ti-eye"></i></a>
                    <a href="{{ path('app_acteur_edit', {'id': acteur.id}) }}"class="btn btn-secondary"><i class="ti ti-settings"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_acteur_new') }}"class="btn btn-success">Create new</a>
{% endblock %}
