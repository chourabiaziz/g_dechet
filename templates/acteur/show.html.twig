{% extends 'base.html.twig' %}

{% block title %}Acteur{% endblock %}

{% block body %}
    <h1>Acteur</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ acteur.id }}</td>
            </tr>
            <tr>
                <th>Nom</th>
                <td>{{ acteur.nom }}</td>
            </tr>
            <tr>
                <th>Role</th>
                <td>{{ acteur.role }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_acteur_index') }}">back to list</a>

    <a href="{{ path('app_acteur_edit', {'id': acteur.id}) }}"class="btn btn-secondary"><i class="ti ti-settings"></i></a>

    {{ include('acteur/_delete_form.html.twig') }}
{% endblock %}
