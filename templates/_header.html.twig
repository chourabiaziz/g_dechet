<!-- JavaScript for Currency Selection -->
<script>
document.addEventListener('DOMContentLoaded', function() {
    // Currency switcher functionality
    const currencyOptions = document.querySelectorAll('.currency-option');
    const currentCurrencyElement = document.getElementById('currentCurrency');
    
    // Initialize currency from localStorage or default to USD
    function initializeCurrency() {
        const savedCurrency = localStorage.getItem('userCurrency') || 'USD';
        setActiveCurrency(savedCurrency);
        
        // Dispatch event for other parts of the application
        document.dispatchEvent(new CustomEvent('currencyChanged', {
            detail: { currency: savedCurrency }
        }));
    }
    
    // Set active currency
    function setActiveCurrency(currency) {
        // Update dropdown display
        if (currentCurrencyElement) {
            currentCurrencyElement.textContent = currency;
        }
        
        // Update active state in dropdown
        currencyOptions.forEach(option => {
            if (option.getAttribute('data-currency') === currency) {
                option.classList.add('active');
                option.innerHTML = addCheckmark(option.innerHTML);
            } else {
                option.classList.remove('active');
                option.innerHTML = removeCheckmark(option.innerHTML);
            }
        });
        
        // Save to localStorage
        localStorage.setItem('userCurrency', currency);
        
        // Update page content based on selected currency
        updatePageContent(currency);
    }
    
    // Add checkmark to active currency
    function addCheckmark(html) {
        if (!html.includes('ti-check')) {
            return html.replace('</div>', '<i class="ti ti-check ms-auto text-success"></i></div>');
        }
        return html;
    }
    
    // Remove checkmark from currency
    function removeCheckmark(html) {
        return html.replace('<i class="ti ti-check ms-auto text-success"></i>', '');
    }
    
    // Update page content based on currency
    function updatePageContent(currency) {
        // Update all price elements on the page
        updatePrices(currency);
        
        // You can add more updates here based on the selected currency
        console.log('Currency updated to:', currency);
    }
    
    // Update prices throughout the application
    function updatePrices(currency) {
        const priceElements = document.querySelectorAll('[data-price-usd]');
        priceElements.forEach(element => {
            const usdPrice = parseFloat(element.getAttribute('data-price-usd'));
            const convertedPrice = convertCurrency(usdPrice, currency);
            const formattedPrice = formatCurrency(convertedPrice, currency);
            element.textContent = formattedPrice;
        });
    }
    
    // Simple currency conversion (replace with real rates from your backend)
    function convertCurrency(amount, toCurrency) {
        const conversionRates = {
            'USD': 1,
            'EUR': 0.85,
            'GBP': 0.73,
            'TND': 3.10, // Example rate: 1 USD = 3.10 TND
            'CAD': 1.25,
            'AUD': 1.35,
            'JPY': 110.50,
            'CNY': 6.45
        };
        
        return amount * (conversionRates[toCurrency] || 1);
    }
    
    // Format currency based on type
    function formatCurrency(amount, currency) {
        const formatters = {
            'USD': new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD' }),
            'EUR': new Intl.NumberFormat('de-DE', { style: 'currency', currency: 'EUR' }),
            'GBP': new Intl.NumberFormat('en-GB', { style: 'currency', currency: 'GBP' }),
            'TND': new Intl.NumberFormat('ar-TN', { style: 'currency', currency: 'TND' }),
            'CAD': new Intl.NumberFormat('en-CA', { style: 'currency', currency: 'CAD' }),
            'AUD': new Intl.NumberFormat('en-AU', { style: 'currency', currency: 'AUD' }),
            'JPY': new Intl.NumberFormat('ja-JP', { style: 'currency', currency: 'JPY' }),
            'CNY': new Intl.NumberFormat('zh-CN', { style: 'currency', currency: 'CNY' })
        };
        
        return formatters[currency] ? formatters[currency].format(amount) : `${currency} ${amount.toFixed(2)}`;
    }
    
    // Event listeners for currency options
    currencyOptions.forEach(option => {
        option.addEventListener('click', function() {
            const selectedCurrency = this.getAttribute('data-currency');
            setActiveCurrency(selectedCurrency);
        });
    });
    
    // Initialize on page load
    initializeCurrency();
});

// You can also listen for currency changes in other parts of your application:
document.addEventListener('currencyChanged', function(e) {
    console.log('Currency changed to:', e.detail.currency);
    // Add any global currency change handlers here
});
</script>

