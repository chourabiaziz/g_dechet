{% extends 'base.html.twig' %}

{% block title %}Tracabilite index{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="mb-0">Tracabilite index</h1>
        <input type="search" class="form-control form-control-sm js-table-search" style="max-width: 280px;" data-target="#tracabilite-table" placeholder="Recherche dynamique...">
    </div>

    <table id="tracabilite-table" class="table table-striped" data-sortable="true">
        <thead>
            <tr>
                <th>Id</th>
                <th>Historique</th>
                <th>DateMiseAJour</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for tracabilite in tracabilites %}
            <tr>
                <td>{{ tracabilite.id }}</td>
                <td>{{ tracabilite.historique }}</td>
                <td>{{ tracabilite.dateMiseAJour ? tracabilite.dateMiseAJour|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_tracabilite_show', {'id': tracabilite.id}) }}"class="btn btn-info"><i class="ti ti-eye"></i></a>
                    <a href="{{ path('app_tracabilite_edit', {'id': tracabilite.id}) }}"class="btn btn-secondary"><i class="ti ti-settings"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_tracabilite_new') }}"class="btn btn-success">Create new</a>
{% endblock %}
