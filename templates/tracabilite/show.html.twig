{% extends 'base.html.twig' %}

{% block title %}Tracabilite{% endblock %}

{% block body %}
    <h1>Tracabilite</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ tracabilite.id }}</td>
            </tr>
            <tr>
                <th>Historique</th>
                <td>{{ tracabilite.historique }}</td>
            </tr>
            <tr>
                <th>DateMiseAJour</th>
                <td>{{ tracabilite.dateMiseAJour ? tracabilite.dateMiseAJour|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_tracabilite_index') }}">back to list</a>

    <a href="{{ path('app_tracabilite_edit', {'id': tracabilite.id}) }}"class="btn btn-secondary"><i class="ti ti-settings"></i></a>

    {{ include('tracabilite/_delete_form.html.twig') }}
{% endblock %}
