{% extends 'base.html.twig' %}

{% block title %}Infrastructure index{% endblock %}

{% block body %}
    <h1>Infrastructure index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for infrastructure in infrastructures|reverse %}
            <tr>
                <td>{{ infrastructure.id }}</td>
                <td>{{ infrastructure.nom }}</td>
                <td>{{ infrastructure.type }}</td>
                <td>
                    <a href="{{ path('app_infrastructure_show', {'id': infrastructure.id}) }}"class="btn btn-info"><i class="ti ti-eye"></i></a>
                    <a href="{{ path('app_infrastructure_edit', {'id': infrastructure.id}) }}"class="btn btn-secondary"><i class="ti ti-settings"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_infrastructure_new') }}"class="btn btn-success">Create new</a>
{% endblock %}
