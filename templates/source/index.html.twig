{% extends 'base.html.twig' %}

{% block title %}Source index{% endblock %}

{% block body %}
    <h1>Source index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for source in sources|reverse %}
            <tr>
                <td>{{ source.id }}</td>
                <td>{{ source.nom }}</td>
                <td>{{ source.type }}</td>
                <td>
                    <a href="{{ path('app_source_show', {'id': source.id}) }}"class="btn btn-info"><i class="ti ti-eye"></i></a>
                    <a href="{{ path('app_source_edit', {'id': source.id}) }}"class="btn btn-secondary"><i class="ti ti-settings"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_source_new') }}"class="btn btn-success">Create new</a>
{% endblock %}
