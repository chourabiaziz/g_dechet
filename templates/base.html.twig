		<script>
			// Fonction pour afficher les toasts
			function showToast(type, title, message, duration = 5000) {
				const toastContainer = document.getElementById('toastContainer');
				
				const icons = {
					'success': '✓',
					'error': '⚠',
					'warning': '⚠',
					'info': 'ℹ'
				};

				const titlesMap = {
					'success': 'Succès',
					'error': 'Erreur',
					'warning': 'Attention',
					'info': 'Information'
				};

				const toastId = 'toast-' + Date.now();
				const toastHtml = `
					<div id="${toastId}" class="toast custom-toast toast-${type}" role="alert" data-bs-delay="${duration}">
						<div class="toast-header">
							<strong class="me-auto">
								<span style="margin-right: 8px;">${icons[type]}</span>
								${title || titlesMap[type]}
							</strong>
							<small class="text-muted">à l'instant</small>
							<button type="button" class="btn-close" data-bs-dismiss="toast" aria-label="Close"></button>
						</div>
						<div class="toast-body">
							${message}
						</div>
					</div>
				`;

				toastContainer.insertAdjacentHTML('beforeend', toastHtml);
				
				const toastElement = document.getElementById(toastId);
				const toast = new bootstrap.Toast(toastElement);
				
				toastElement.addEventListener('hidden.bs.toast', function () {
					this.remove();
				});

				toast.show();
			}

			// Fonction de compte à rebours
			function startCountdown(startDate) {
				const countdownElement = document.getElementById('countdownTimer');
				if (!countdownElement) return;

				function updateCountdown() {
					const now = new Date().getTime();
					const startTime = new Date(startDate).getTime();
					const distance = startTime - now;

					if (distance < 0) {
						countdownElement.innerHTML = '<div class="countdown-finished">Plan Started! <br>Page will refresh...</div>';
						setTimeout(() => {
							window.location.reload();
						}, 3000);
						return;
					}

					// Calcul du temps restant
					const days = Math.floor(distance / (1000 * 60 * 60 * 24));
					const hours = Math.floor((distance % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60));
					const minutes = Math.floor((distance % (1000 * 60 * 60)) / (1000 * 60));
					const seconds = Math.floor((distance % (1000 * 60)) / 1000);

					// Formatage de l'affichage
					let countdownText = '';
					if (days > 0) {
						countdownText += `${days}d `;
					}
					countdownText += `${hours.toString().padStart(2, '0')}h ${minutes.toString().padStart(2, '0')}m ${seconds.toString().padStart(2, '0')}s`;

					countdownElement.textContent = countdownText;
				}

				// Mise à jour immédiate puis toutes les secondes
				updateCountdown();
				setInterval(updateCountdown, 1000);
			}

			// Initialisation au chargement de la page
			document.addEventListener('DOMContentLoaded', function() {
				// Messages flash Symfony
				{% for type, messages in app.flashes %}
					{% for message in messages %}
						showToast('{{ type }}', '', '{{ message|raw }}');
					{% endfor %}
				{% endfor %}

				// CORRECTION : Démarrer le compte à rebours si nécessaire
 
				{% if countdownData is defined and countdownData is not null and countdownData.enabled %}
    startCountdown('{{ countdownData.startDate }}');
{% endif %}

				// Fonction globale
				window.showToast = showToast;
			});

			// Gestion des erreurs AJAX globales
			$(document).ajaxError(function(event, jqXHR, ajaxSettings, thrownError) {
				if (jqXHR.status === 500) {
					showToast('error', 'Erreur serveur', 'Une erreur est survenue lors de la requête.');
				} else if (jqXHR.status === 404) {
					showToast('error', 'Non trouvé', 'La ressource demandée n\'a pas été trouvée.');
				} else if (jqXHR.status === 403) {
					showToast('error', 'Accès refusé', 'Vous n\'avez pas les permissions nécessaires.');
				}
			});
		</script>
 	
{% if app.user and app.user.isBlocked %}
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            showToast('error', 'Compte bloqué', 'Votre compte a été bloqué. Veuillez contacter l\'administrateur.', 10000);

            const overlay = document.createElement('div');
            overlay.style.position = 'fixed';
            overlay.style.top = '0';
            overlay.style.left = '0';
            overlay.style.width = '100%';
            overlay.style.height = '100%';
            overlay.style.backgroundColor = 'rgba(0,0,0,0.5)';
            overlay.style.zIndex = '999999';
            overlay.style.cursor = 'not-allowed';
            document.body.appendChild(overlay);

            document.body.addEventListener('click', function(e) {
                e.stopPropagation();
                e.preventDefault();
            }, true);

            document.body.addEventListener('keydown', function(e) {
                e.stopPropagation();
                e.preventDefault();
            }, true);
        });
    </script>
{% endif %}








	

