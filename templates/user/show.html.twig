{% extends 'base.html.twig' %}

{% block title %}{{ 'user.details_title'|trans }}{% endblock %}

{% block body %}
<h1>{{ 'user.details_heading'|trans }}</h1>

<table class="table table-bordered">
    <tr><th>{{ 'user.id'|trans }}</th><td>{{ user.id }}</td></tr>
    <tr><th>{{ 'user.name'|trans }}</th><td>{{ user.name }}</td></tr>
    <tr><th>{{ 'user.prename'|trans }}</th><td>{{ user.prename }}</td></tr>
    <tr><th>{{ 'user.email'|trans }}</th><td>{{ user.email }}</td></tr>
    <tr>
        <th>{{ 'user.phone'|trans }}</th>
        <td>
            {% if user.phone %}
                <a href="tel:{{ user.phone }}">{{ user.phone }}</a>
            {% else %}
                {{ 'user.no_phone'|trans }}
            {% endif %}
        </td>
    </tr>
    <tr><th>{{ 'user.specialty'|trans }}</th><td>{{ user.specialty }}</td></tr>
    <tr><th>{{ 'user.current_plan'|trans }}</th><td>{{ user.plan ? user.plan.name : '—' }}</td></tr>
    <tr><th>{{ 'user.roles'|trans }}</th><td>{{ user.roles|join(', ') }}</td></tr>
    <tr>
        <th>{{ 'user.blocked'|trans }}</th>
        <td>
            {% if user.isBlocked %}
                <span class="badge bg-danger">{{ 'user.blocked_yes'|trans }}</span>
            {% else %}
                <span class="badge bg-success">{{ 'user.blocked_no'|trans }}</span>
            {% endif %}
        </td>
    </tr>
    <tr>
        <th>{{ 'user.registration_date'|trans }}</th>
        <td>{{ user.registrationDate ? user.registrationDate|date('Y-m-d H:i') : '—' }}</td>
    </tr>
</table>

<h2 class="mt-4">{{ 'user.subscriptions_history'|trans }}</h2>

<table class="table table-striped table-responsive">
    <thead>
        <tr>
            <th>{{ 'subscription.plan'|trans }}</th>
            <th>{{ 'subscription.start_date'|trans }}</th>
            <th>{{ 'subscription.end_date'|trans }}</th>
            <th>{{ 'subscription.status'|trans }}</th>
        </tr>
    </thead>
    <tbody>
        {% for abo in user.abonnements %}
            <tr>
                <td>{{ abo.plan.name }}</td>
                <td>{{ abo.startDate ? abo.startDate|date('Y-m-d') : '—' }}</td>
                <td>{{ abo.endDate ? abo.endDate|date('Y-m-d') : '—' }}</td>
                <td>
                    {% if abo.isActive %}
                        <span class="badge bg-success">{{ 'subscription.active'|trans }}</span>
                    {% else %}
                        <span class="badge bg-secondary">{{ 'subscription.expired'|trans }}</span>
                    {% endif %}
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="6" class="text-center">{{ 'subscription.none_found'|trans }}</td>
            </tr>
        {% endfor %}
    </tbody>
</table>

<div class="mt-3">
     <a class="btn btn-primary" href="{{ path('app_user_edit', {'id': user.id}) }}">
        {{ 'user.edit_button'|trans }}
     </a>
</div>
{% endblock %}
