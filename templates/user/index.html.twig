{% extends 'base.html.twig' %}

{% block title %}Users{% endblock %}

{% block body %}
<h1 class="mb-4">Users</h1>

<div class="d-flex align-items-center justify-content-between mb-3">
    <div class="flex-grow-1"></div>
    <input type="search" class="form-control form-control-sm js-table-search" style="max-width: 280px;" data-target="#users-table" placeholder="Recherche dynamique...">
</div>

<div class="table-responsive">
    <table id="users-table" class="table table-striped table-hover align-middle" data-sortable="true">
        <thead class="table-dark">
            <tr>
                <th>Id</th>
                <th>Name</th>
                <th>Prename</th>
                <th>Email</th>
                <th>Phone</th>
                <th>Specialty</th>
                <th>Last Plan</th>
                <th>Blocked</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
        {% for user in users %}
            <tr>
                <td>{{ user.id }}</td>
                <td>{{ user.name }}</td>
                <td>{{ user.prename }}</td>
                <td>
                    {% if user.email %}
                        <a href="mailto:{{ user.email }}">{{ user.email }}</a>
                    {% else %}
                        N/A
                    {% endif %}
                </td>
                <td>
                    {% if user.phone %}
                        <a href="tel:{{ user.phone }}">{{ user.phone }}</a>
                    {% else %}
                        N/A
                    {% endif %}
                </td>
                <td>{{ user.specialty }}</td>
<td>
    {% set lastAbo = user.abonnements|last %}
    {{ lastAbo ? lastAbo.plan.name : '—' }}
</td>
                <td>
                    {% if user.isBlocked %}
                        <span class="badge bg-danger">Yes</span>
                    {% else %}
                        <span class="badge bg-success">No</span>
                    {% endif %}
                </td>
                <td class="d-flex flex-wrap gap-1">
                    <a class="btn btn-sm btn-primary" href="{{ path('app_user_show', {'id': user.id}) }}"class="btn btn-info"><i class="ti ti-eye"></i></a>
                    <a class="btn btn-sm btn-secondary" href="{{ path('app_user_edit', {'id': user.id}) }}"class="btn btn-secondary"><i class="ti ti-settings"></i></a>

                    <form method="post" action="{{ path('app_user_delete', {'id': user.id}) }}" style="display:inline-block" onsubmit="return confirm('Are you sure?');">
                        <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ user.id) }}">
                        <button class="btn btn-sm btn-danger">Delete</button>
                    </form>

                    <form method="post" action="{{ path('app_user_block', {'id': user.id}) }}" style="display:inline-block">
                        <button class="btn btn-sm btn-warning">{{ user.isBlocked ? 'Unblock' : 'Block' }}</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="9" class="text-center">No users found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>
{% endblock %}
