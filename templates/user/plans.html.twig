{% extends 'base.html.twig' %}

{% block title %}{{ 'plans.title'|trans }}{% endblock %}

{% block body %}
<div class="container py-4">
    <h1 class="mb-4">{{ 'plans.heading'|trans }}</h1>

    <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5 class="mb-0">{{ 'plans.list_title'|trans }}</h5>
            <span class="badge bg-primary">
                {{ plans|length }} {{ 'plans.found'|trans({'%count%': plans|length}) }}
            </span>
        </div>
        <div class="card-body table-responsive">
            <table class="table table-striped table-bordered align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>{{ 'plans.name'|trans }}</th>
                        <th>{{ 'plans.price'|trans }}</th>
                        <th>{{ 'plans.member_limit'|trans }}</th>
                        <th>{{ 'plans.description'|trans }}</th>
                        <th>{{ 'plans.duration'|trans }}</th>
                        <th>{{ 'plans.from_to'|trans }}</th>
                        <th>{{ 'plans.actions'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for plan in plans|reverse %}
                        {% set lastAbonnement = plan.abonnements|sort((a, b) => b.endDate.timestamp <=> a.endDate.timestamp)|first %}
                        <tr>
                            <td>{{ plan.name }}</td>
                            <td>{{ plan.monthlyPrice }} TND</td>
                            <td>{{ plan.memberLimit }}</td>
                            <td>{{ plan.description }}</td>
                            <td>
                                {% if lastAbonnement %}
                                    {{ lastAbonnement.startDate.diff(lastAbonnement.endDate).days }}
                                {% else %}
                                    {{ 'plans.na'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                {% if lastAbonnement %}
                                    {{ lastAbonnement.startDate|date('d/m/Y') }} - {{ lastAbonnement.endDate|date('d/m/Y') }}
                                {% else %}
                                    {{ 'plans.na'|trans }}
                                {% endif %}
                            </td>
                            <td>
                                <a href="{{ path('app_plan_show', {'id': plan.id}) }}" class="btn btn-sm btn-primary">
                                    <i class="ti ti-eye me-1"></i> {{ 'plans.view'|trans }}
                                </a>
                            </td>
                        </tr>
                    {% else %}
                        <tr>
                            <td colspan="7" class="text-center">{{ 'plans.none_found'|trans }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
