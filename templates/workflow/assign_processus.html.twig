{% extends 'base.html.twig' %}

{% block title %}Assignation au Processus{% endblock %}

{% block body %}
<div class="container mt-4">
    <div class="row">
        <div class="col-md-8 offset-md-2">
            <div class="card">
                <div class="card-header">
                    <h2>⚙️ Étape 2: Assignation au Processus</h2>
                </div>
                <div class="card-body">
                    <div class="dechet-info mb-4 p-3 bg-light rounded">
                        <h5>Déchet à traiter:</h5>
                        <p><strong>Type:</strong> {{ dechet.type }} | <strong>Quantité:</strong> {{ dechet.quantite }} | <strong>État:</strong> {{ dechet.etat }}</p>
                    </div>

                    <form method="post">
                        <div class="mb-3">
                            <label for="processus_id" class="form-label">Sélectionner un processus:</label>
                            <select name="processus_id" id="processus_id" class="form-select" required>
                                <option value="">Choisir un processus...</option>
                                {% for processus in processus_disponibles %}
                                    <option value="{{ processus.id }}">
                                        {{ processus.nom }} (Autorité: {{ processus.autorite.nom }})
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div class="mt-3">
                            <button type="submit" class="btn btn-primary">
                                🔗 Assigner au Processus
                            </button>
                            <a href="{{ path('app_dechet_workflow') }}" class="btn btn-secondary">
                                Retour au Workflow
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}