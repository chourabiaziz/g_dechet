<form method="post" action="{{ path('app_produit_recycl__delete', {'id': produit_recycl_.id}) }}" onsubmit="return confirm('Are you sure you want to delete this item?');">
    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ produit_recycl_.id) }}">
    <button class="btn btn-danger m-1"><i class="ti ti-trash" ></i>Supprimer</button>
</form>
