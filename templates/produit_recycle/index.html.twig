{% extends 'base.html.twig' %}

{% block title %}ProduitRecycle index{% endblock %}

{% block body %}
    <div class="d-flex align-items-center justify-content-between mb-3">
        <h1 class="mb-0">ProduitRecycle index</h1>
        <input type="search" class="form-control form-control-sm js-table-search" style="max-width: 280px;" data-target="#produits-table" placeholder="Recherche dynamique...">
    </div>

    <table id="produits-table" class="table table-striped" data-sortable="true">
        <thead>
            <tr>
                <th>Id</th>
                <th>Nom</th>
                <th>Type</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for produit_recycl_ in produit_recycl_s %}
            <tr>
                <td>{{ produit_recycl_.id }}</td>
                <td>{{ produit_recycl_.nom }}</td>
                <td>{{ produit_recycl_.type }}</td>
                <td>
                    <a href="{{ path('app_produit_recycl__show', {'id': produit_recycl_.id}) }}"class="btn btn-info"><i class="ti ti-eye"></i></a>
                    <a href="{{ path('app_produit_recycl__edit', {'id': produit_recycl_.id}) }}"class="btn btn-secondary"><i class="ti ti-settings"></i></a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="4">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_produit_recycl__new') }}"class="btn btn-success">Create new</a>
{% endblock %}
